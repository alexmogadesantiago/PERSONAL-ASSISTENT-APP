n8n_data/
postgres_data/

# Sistema
*.log
.DS_Store
Thumbs.db

# Borradores generados
output/**/*.md

# Artefactos de build
dist/
pkgroot/

# Backend (Python)
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

