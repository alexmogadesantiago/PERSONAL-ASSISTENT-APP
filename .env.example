# ============================================================
#  Personal Assistant - configuración local (FASE 1)
#  Copia este fichero a `.env` y rellena los valores marcados.
#  `.env` está en .gitignore: NUNCA lo subas a git.
# ============================================================

# --- PostgreSQL (base de datos interna de n8n) ---
POSTGRES_DB=assistant
POSTGRES_USER=assistant
# Pon una contraseña larga y aleatoria (>= 24 caracteres).
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASENA_LARGA

# --- n8n ---
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_LOG_LEVEL=info
# Clave de cifrado de credenciales de n8n. 32+ caracteres aleatorios.
# Genérala con:  powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
N8N_ENCRYPTION_KEY=CAMBIA_ESTO_32_CARACTERES_ALEATORIOS_MINIMO

# --- n8n-mcp (servidor MCP para construir workflows desde Claude Code) ---
# Sin estas dos vars, n8n-mcp funciona en modo solo-documentacion (7 tools).
# Con ellas, ademas gestiona la instancia n8n (crear/actualizar/ejecutar workflows).
# Genera la API key en n8n: Settings -> n8n API -> Create an API key.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

TZ=Europe/Madrid

# --- Modo de despliegue ------------------------------------------------------
# PA_MODE distingue como esta desplegado el conjunto. Lo escribe el instalador.
#
#   development        trabajas desde un clon del repositorio: Vite en marcha,
#                      puertos a mano, .env junto al docker-compose.
#   production-local   lo que instala Personal-Assistant-Setup.exe: imagenes
#                      construidas, cada puerto publicado SOLO en 127.0.0.1,
#                      datos en %LOCALAPPDATA%, ninguna dependencia de AWS,
#                      Oracle Cloud ni Render.
#
# El backend mantiene su propio AC_ENVIRONMENT (development / testing /
# staging / production) para validar su configuracion: son cosas distintas y
# no se tocan entre si.
PA_MODE=production-local

# --- Donde viven TUS datos ---------------------------------------------------
# El instalador de Windows escribe estas tres rutas apuntando a
# %LOCALAPPDATA%\Personal Assistant, para que nada modificable acabe dentro del
# directorio de instalacion (Program Files no es escribible por el usuario).
# Docker las quiere con barras normales, incluso en Windows.
#
# Si trabajas desde un clon del repositorio puedes dejarlas vacias: el
# docker-compose cae entonces en ./config y ./output, como siempre.
#
#   PA_DATA_DIR=C:/Users/tu-usuario/AppData/Local/Personal Assistant
#   PA_CONFIG_DIR=C:/Users/tu-usuario/AppData/Local/Personal Assistant/config
#   PA_OUTPUT_DIR=C:/Users/tu-usuario/AppData/Local/Personal Assistant/output
#
# La base de datos de Postgres y el volumen de n8n NO son rutas: son volumenes
# con nombre de Docker y sobreviven a actualizaciones y desinstalaciones que no
# pidan borrar los datos.

# --- IA: como llegan los workflows al proveedor ---
# Los workflows de n8n YA NO llevan la clave de ningun proveedor. Llaman al
# Automation Center (/api/ai/generate) y es el panel quien decide el proveedor
# y el modelo. Solo necesitan saber donde esta el backend y con que token.
#
# AC_SERVICE_TOKEN se genera en el panel:
#   Settings -> Artificial Intelligence -> Automation token -> Generate
# y se pega aqui. Se muestra una sola vez.
AC_API_URL=http://backend:8080
AC_SERVICE_TOKEN=
# Perfil que usan las automatizaciones. El personalizador visual guarda el
# perfil en PostgreSQL y los workflows lo piden a /api/profiles/runtime, asi
# que ya NO existe config/user_profile.json como fuente. Copia aqui el id que
# ves en la URL del panel: /profiles/<id>/personalise
AC_PROFILE_ID=

# --- Google AI Studio (Gemini) --- OPCIONAL
# Ya no es obligatorio. Si tienes una instalacion antigua con esta clave, sigue
# funcionando sin tocar nada: el backend la detecta y usa Gemini como proveedor
# mientras no configures otro.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram ---
# Un bot por workflow (así puedes silenciar/activar cada uno por separado).
# Para cada uno: @BotFather -> /newbot -> copia el token.
# El chat id es el mismo para todos: escribe a cualquiera de tus bots y abre
#   https://api.telegram.org/bot<TOKEN>/getUpdates  -> copia "chat":{"id": ...}
TELEGRAM_CHAT_ID=PEGA_AQUI_TU_CHAT_ID
TELEGRAM_NOTICIAS_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_BOT_DE_NOTICIAS
TELEGRAM_TOKEN_MARCA=PEGA_AQUI_EL_TOKEN_DEL_BOT_DE_MARCA_PERSONAL
TELEGRAM_TOKEN_LABORAL=PEGA_AQUI_EL_TOKEN_DEL_BOT_DE_LABORAL
TELEGRAM_TOKEN_EMAIL=PEGA_AQUI_EL_TOKEN_DEL_BOT_DE_EMAIL

# --- Google OAuth (SOLO para el workflow Email) ---
# No va aquí: se configura como credencial dentro de n8n (Credentials -> New).
# Pasos en CREDENCIALES.md, sección 3.

# ============================================================
#  Automation Center (backend / panel de control)
# ============================================================
# development | staging | production. En production el backend exige
# AC_JWT_SECRET y AC_CREDENTIAL_ENCRYPTION_KEY reales o no arranca sano.
AC_ENVIRONMENT=production
BACKEND_PORT=8080

# El entrypoint aplica migraciones (alembic upgrade head, idempotente) al
# arrancar si AC_RUN_MIGRATIONS=1 (por defecto). AC_ENSURE_DATABASE=1 (por
# defecto) intenta CREATE DATABASE si no existe (necesita rol admin). En
# Postgres gestionado (Render, Neon, Supabase, RDS) la BD ya existe y el rol
# no puede crearla: pon AC_ENSURE_DATABASE=0.
AC_RUN_MIGRATIONS=1
AC_ENSURE_DATABASE=1

# Orígenes del navegador permitidos (el frontend). Coma-separado.
# Local: http://localhost:3000  ·  Producción: https://automation-center.vercel.app
#   (y más adelante https://app.automation-center.com)
# Los dos origenes del panel: para el navegador localhost y 127.0.0.1 NO son
# el mismo origen, y con solo uno el otro se queda sin cabecera CORS.
AC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcional: regex de orígenes permitidos SOLO para previews de Vercel de TU proyecto.
# Nunca uses ".*". Ejemplo (ajusta el slug del proyecto):
#   AC_CORS_ORIGIN_REGEX=https://automation-center-[a-z0-9-]+\.vercel\.app
AC_CORS_ORIGIN_REGEX=

# Proxies inversos de confianza (CIDR, coma-separado). Solo si el backend está
# DETRÁS de un proxy/balanceador: entonces se hace caso a X-Forwarded-For para
# el rate-limiting. Vacío (por defecto) = backend expuesto directo, se ignora
# X-Forwarded-For (es falsificable por el cliente).
#   nginx/Traefik en el mismo host:  AC_TRUSTED_PROXIES=127.0.0.1/32,::1/128
#   balanceador cloud:               el rango de salida de ese balanceador
AC_TRUSTED_PROXIES=

# Firma de los JWT de sesión. 32+ caracteres aleatorios. El instalador la genera.
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
AC_JWT_SECRET=CAMBIA_ESTO_32_CARACTERES_ALEATORIOS_MINIMO

# Clave de cifrado en reposo de las credenciales (Fernet, 44 chars base64 url-safe).
# La genera el instalador:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AC_CREDENTIAL_ENCRYPTION_KEY=

# ------------------------------------------------------------------
#  Integraciones
#
#  IMPORTANTE: a partir de la v0.5 estas variables son solo el VALOR POR
#  DEFECTO. Lo que configures en el panel web (Ajustes -> Servicios) se guarda
#  cifrado en PostgreSQL y TIENE PRIORIDAD sobre el entorno, y se aplica en la
#  siguiente comprobacion de salud sin reiniciar ni redesplegar nada.
#  Estas variables sirven para arranques desatendidos (instalador, CI, Docker).
# ------------------------------------------------------------------

# n8n (opcional hasta que crees la API key en n8n: Settings -> n8n API).
# El backend tambien lee N8N_API_KEY / N8N_API_URL de mas arriba si existen.
AC_N8N_BASE_URL=http://n8n:5678
AC_N8N_API_KEY=

# Servicio de scraping (Playwright). Vacio = NOT_CONFIGURED, que no es un error:
# significa que este entorno no lo tiene desplegado.
AC_PLAYWRIGHT_BASE_URL=http://playwright:3000

# --- Proveedores de IA -------------------------------------------------------
# Todo esto es OPCIONAL. Lo normal es configurarlo desde el panel
# (Settings -> Artificial Intelligence), que lo guarda cifrado en la tabla
# `service_configs`; la base de datos tiene prioridad sobre estas variables.
#
# Vacio AC_AI_PROVIDER = decidir automaticamente: el primer proveedor que tenga
# credencial, en el orden NVIDIA NIM -> OpenRouter -> Gemini. Por eso una
# instalacion antigua que solo tenia GEMINI_API_KEY sigue funcionando igual.
AC_AI_PROVIDER=
AC_AI_MODEL=
AC_AI_FALLBACK_PROVIDER=
# La comprobacion de salud llama de verdad al proveedor y cachea el veredicto
# estos segundos, para que el monitor (que tiquea cada 5 s) no gaste cuota.
AC_AI_VERIFY_TTL_SECONDS=300
# Token que n8n presenta en /api/ai/generate. Normalmente se genera desde el
# panel; esta variable es solo el respaldo de entorno.
AC_AI_SERVICE_TOKEN=

# NVIDIA NIM (proveedor principal recomendado).
# Clave: https://build.nvidia.com -> abre un modelo -> Get API Key (nvapi-...).
# BASE_URL solo hace falta si usas un NIM autoalojado.
AC_NVIDIA_NIM_API_KEY=
AC_NVIDIA_NIM_BASE_URL=
AC_NVIDIA_NIM_MODEL=

# OpenRouter (alternativa / fallback). Clave: https://openrouter.ai/keys
AC_OPENROUTER_API_KEY=
AC_OPENROUTER_BASE_URL=
AC_OPENROUTER_MODEL=

# Gemini (opcional, compatibilidad). El backend tambien acepta GEMINI_API_KEY.
AC_GEMINI_API_KEY=
AC_GEMINI_MODEL=gemini-2.5-flash

# NOTA: no existe AC_PROFILE_BASE_URL. El estado PROFILE del monitor no es una
# sonda HTTP: lee la tabla `profiles` y comprueba que hay datos minimos reales.

# Monitorizacion en tiempo real: cada cuantos segundos muestrea el hub central
# (un solo bucle para todos los clientes WebSocket).
AC_MONITOR_INTERVAL_SECONDS=5

# ============================================================
#  Frontend (solo modo local con docker compose; en producción lo aloja Vercel)
# ============================================================
FRONTEND_PORT=3000
# URLs del backend que el navegador usará (Vite las incrusta en el build).
# Local: apuntan al puerto publicado del backend.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
# En Vercel se configuran en Project Settings -> Environment Variables:
#   VITE_API_URL = https://api.automation-center.example
#   VITE_WS_URL  = wss://api.automation-center.example

