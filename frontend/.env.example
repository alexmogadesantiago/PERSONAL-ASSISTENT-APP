# ============================================================
#  Automation Center — frontend (Vite / React)
#  Copy to `.env.local` for local dev. Vercel reads these from
#  Project Settings → Environment Variables (never commit real values).
# ============================================================

# Base URL of the FastAPI backend (no trailing slash).
#   local  : http://localhost:8080
#   prod   : https://api.automation-center.example
VITE_API_URL=http://localhost:8080

# WebSocket base URL of the backend (no trailing slash, no path).
# Optional: if unset it is derived from VITE_API_URL
# (http->ws, https->wss).
#   local  : ws://localhost:8080
#   prod   : wss://api.automation-center.example
VITE_WS_URL=ws://localhost:8080

# Shown in the UI footer / settings. Purely cosmetic.
VITE_APP_ENV=development

# ------------------------------------------------------------
#  What must NEVER be set here
# ------------------------------------------------------------
# Vite inlines every VITE_* value into the JavaScript it ships, so anything
# put here is published to every visitor. Provider credentials
# (NVIDIA NIM, OpenRouter, Gemini) live in the backend's `service_configs`
# table, are written from Settings -> Artificial Intelligence, and are
# reached only through FastAPI:
#
#   Browser -> Vercel frontend -> FastAPI -> AIService -> NIM / OpenRouter / Gemini
#
# Never add NVIDIA_NIM_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY or any
# VITE_* equivalent to this file or to the Vercel project settings.
# `src/security.test.ts` fails the build if one appears.
